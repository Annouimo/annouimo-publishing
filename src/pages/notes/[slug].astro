---
import Base from '../../layouts/Base.astro';
import Article from '../../layouts/Article.astro';
import { sectionLabels, sectionPaths } from '../../lib/sections';
import { notes, isPreview } from '../../lib/notes';
export function getStaticPaths() { return notes.map(note => ({ params: { slug: note.slug }, props: { note } })); }
const { note } = Astro.props;
const { Content, frontmatter } = note;
const headings = note.getHeadings().filter(h => h.depth === 2);
---
<Base title={frontmatter.title} description={frontmatter.description} preview={isPreview}>
  <Article title={frontmatter.title} description={frontmatter.description} date={frontmatter.date} section={sectionLabels.notes} sectionHref={sectionPaths.notes} headings={headings} draft={frontmatter.draft}>
    <Content />
  </Article>
</Base>
