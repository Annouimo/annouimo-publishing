---
import Base from './Base.astro';

interface Props { title: string; entries: { title: string; href: string; frontmatter: { date: string } }[] }
const { title, entries } = Astro.props;
---
<Base title={title}>
  <section class="reading-width home-intro">
    <h1>{title}</h1>
    <div class="publication-list">
      {entries.map(({ title, href, frontmatter }) => (
        <a class="publication-entry" href={href}><h2>{title}</h2><time datetime={frontmatter.date}>{frontmatter.date.slice(0, 10)}</time></a>
      ))}
    </div>
  </section>
</Base>
