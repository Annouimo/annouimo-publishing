---
import Base from './Base.astro';
import { sectionLabels } from '../lib/sections';
interface Entry {
  title: string;
  href: string;
  section?: keyof typeof sectionLabels;
  frontmatter: { date: string; description?: string; summary?: string };
}
interface Props { title: string; entries: Entry[]; byYear?: boolean; showSection?: boolean; moreHref?: string; moreLabel?: string }
const { title, entries, byYear = false, showSection = false, moreHref, moreLabel } = Astro.props;
const years = byYear ? [...new Set(entries.map(entry => entry.frontmatter.date.slice(0, 4)))] : [''];
const labels = sectionLabels;
---
<Base title={title}>
  <section class="reading-width home-intro publication-index">
    <h1>{title}</h1>
    {years.map(year => (
      <div class="publication-list">
        {year && <h2 class="publication-year">{year}</h2>}
        {(year ? entries.filter(entry => entry.frontmatter.date.startsWith(year)) : entries).map(({ title, href, section, frontmatter }) => (
          <a class="publication-entry" href={href}>
            <div class="publication-entry-copy">
              <span class="publication-title">{title}</span>
              {!byYear && (frontmatter.description || frontmatter.summary) && <p>{frontmatter.description || frontmatter.summary}</p>}
            </div>
            <span class="publication-entry-meta">
              {(byYear || showSection) && section && <span>{labels[section]} · </span>}
              <time datetime={frontmatter.date}>{frontmatter.date.slice(0, 10)}</time>
            </span>
          </a>
        ))}
      </div>
    ))}
  </section>
</Base>
