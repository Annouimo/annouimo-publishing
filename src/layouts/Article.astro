---
interface Props {
  title: string;
  description?: string;
  date: string;
  section: string;
  sectionHref: string;
  draft?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, date, section, sectionHref, draft, headings = [] } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
---
<article class="lesson">
  <header class="lesson-header reading-width ann-page-heading">
    <div class="lesson-meta article-meta"><a href={sectionHref}>{section}</a><span aria-hidden="true">·</span><time datetime={date}>{date.slice(0, 10)}</time>{draft && <span>制作中</span>}</div>
    <h1>{title}</h1>
    {description && <p class="lesson-description ann-heading-details">{description}</p>}
  </header>
  <slot name="toc">
    {sections.length >= 2 && (
      <nav class="article-toc" aria-label="本文目录">
        <details><summary>目录</summary><ul>
          {sections.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ul></details>
      </nav>
    )}
  </slot>
  <div class="prose"><slot /></div>
</article>

<script>
  const nav = document.querySelector<HTMLElement>('.article-toc');
  const details = nav?.querySelector('details');
  const wide = window.matchMedia('(min-width: 1320px)');
  const sync = () => { if (details) details.open = wide.matches; };
  sync();
  wide.addEventListener('change', sync);
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    if (!wide.matches && details) details.open = false;
  }));
</script>
